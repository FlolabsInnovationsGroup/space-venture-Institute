# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

#########################
# Frontend dependencies #
#########################

/frontend/node_modules
/frontend/.next
/frontend/out
/frontend/build

# Yarn / PnP
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/frontend/coverage

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Misc
.DS_Store
*.pem

# Env files (optional)
/frontend/.env*
/frontend/next-env.d.ts

# Vercel
/.vercel

#########################
# Backend (Strapi)      #
#########################

/backend/strapi/node_modules
/backend/strapi/.tmp
/backend/strapi/.cache
/backend/strapi/build
/backend/strapi/public/uploads

# Backend env files
/backend/strapi/.env*
