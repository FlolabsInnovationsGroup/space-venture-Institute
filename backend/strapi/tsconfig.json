{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "outDir": "dist",
    "rootDir": ".",
    "declaration": false,
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": ["./", "src/**/*.json"],
  "exclude": ["node_modules", "build", "dist", ".cache", ".tmp"]
}
